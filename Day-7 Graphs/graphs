        else if(!nodes.contains(v2)){
            System.out.println("V2 is not present");
        }
        else{
            int index1 = nodes.indexOf(v1);
            int index2 = nodes.indexOf(v2);
            graph.get(index1).set(index2, 1);
            graph.get(index2).set(index1, 1);
        }
    }

